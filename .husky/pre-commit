#!/bin/sh
. "$(dirname "$0")/_/husky.sh"

echo "🔍 Pre-commit: verificando arquivos staged com lint-staged..."
npx --no-install lint-staged
RET=$?
if [ $RET -ne 0 ]; then
  echo "❌ Lint-staged falhou. Corrija os erros antes de commitar."
  exit $RET
fi

echo "🔍 Pre-commit: executando lint do backend..."
cd TechAcademy5back || exit 1
npm run lint
RET=$?
if [ $RET -ne 0 ]; then
  echo "❌ Lint do backend falhou. Corrija os erros antes de commitar."
  exit $RET
fi

echo "🔍 Pre-commit: executando testes do backend..."
npm test
RET=$?
if [ $RET -ne 0 ]; then
  echo "❌ Testes do backend falharam. Corrija os testes antes de commitar."
  exit $RET
fi

echo "✅ Pre-commit concluído com sucesso."
exit 0
