#!/usr/bin/env node

const { execFileSync } = require("node:child_process");
const path = require("node:path");

const raiz = path.resolve(__dirname, "..");

function executar(pasta, comando, argumentos) {
  console.log(`🔍 Pre-push: executando ${comando}...`);
  execFileSync(process.platform === "win32" ? `${comando}.cmd` : comando, argumentos, {
    cwd: path.join(raiz, pasta),
    stdio: "inherit",
  });
}

try {
  executar("TechAcademy5back", "npm", ["test"]);
  executar("TechAcademy5front", "npm", ["run", "test:e2e"]);
  console.log("✅ Pre-push concluído com sucesso. Push liberado.");
} catch (erro) {
  console.error("❌ Validação do pre-push falhou. Push bloqueado.");
  process.exit(erro.status ?? 1);
}
