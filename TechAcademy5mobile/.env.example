# Copie para .env e preencha. O .env fica fora do versionamento.
#
# ATENCAO: variavel EXPO_PUBLIC_ e embutida no bundle do aplicativo. Isso
# mantem a credencial fora do repositorio, mas nao a esconde de quem inspecionar
# o app publicado. Serve para o escopo academico deste projeto.

# Formulario de suporte (painel do EmailJS: Account > API Keys e Email Services)
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=

# Opcional: forca o endereco da API. Sem isso o app deduz pelo host do dev
# server do Expo, o que ja funciona na maquina de qualquer pessoa da dupla.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
